{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://energy-analyzer.local/schemas/physical-expertise-requests-v1.json",
  "title": "Physical Expertise Benchmark question cycle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "requests"],
  "properties": {
    "schema_version": {"const": 1},
    "requests": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["request_id", "question", "requested_concepts", "best_responder", "why", "hypotheses_distinguished", "expected_effort"],
        "properties": {
          "request_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{2,79}$"},
          "question": {"type": "string", "minLength": 1},
          "requested_concepts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "best_responder": {"type": "string", "minLength": 1},
          "why": {"type": "string", "minLength": 1},
          "hypotheses_distinguished": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
          "expected_effort": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
